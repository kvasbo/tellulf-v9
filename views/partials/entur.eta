	<strong>Neste baner</strong>
	<table class="footerTable">
		<tbody>
			<% it.trains.forEach((train) => { %>
			<tr>
				<td class="number"><%= train.time %></td>
				<td><%= train.destination %><% if (train.dot) { %> <span class="train-dot train-dot-<%= train.dot %>"></span><% } %></td>
			</tr>
			<% }) %>
		</tbody>
	</table>
