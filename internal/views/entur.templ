package views

import "github.com/kvasbo/tellulf-v9/internal/view"

// Entur is the T-BANE cell: the next departure as the big value in the
// accent colour, and the one after it on the detail line. A dot after a time
// marks a delay (red) or missing realtime data (grey).
templ Entur(t view.Trains) {
	<span class="label">T-bane</span>
	if len(t.Departures) > 0 {
		<div class="value next">
			@departure(t.Departures[0])
		</div>
	}
	if len(t.Departures) > 1 {
		<div class="detail">
			@departure(t.Departures[1])
		</div>
	}
}

templ departure(d view.Train) {
	{ d.Time }
	if d.Dot != "" {
		<span class={ "train-dot", "train-dot-" + d.Dot }></span>
	}
}
