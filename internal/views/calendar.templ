package views

import (
	"github.com/kvasbo/tellulf-v9/internal/calendar"
	"github.com/kvasbo/tellulf-v9/internal/view"
)

// Calendar is the right column: today in full, the coming days on two lines
// each, and the faint corner line. client.js hides whole .day elements from
// the bottom when .days overflows, and fills the two stamp spans after each
// swap.
templ Calendar(c view.Calendar, st view.Stamps) {
	<div class="today">
		<div class="today-head">
			<span class="label">I dag</span>
			@kidsDot(c.Today.Kids)
		</div>
		if c.Today.Dinner != "" {
			<div class="dinner">{ c.Today.Dinner }</div>
		}
		for _, n := range c.Today.Notes {
			<div class="note">{ n }</div>
		}
		for _, e := range c.Today.Events {
			<div class={ "ev", templ.KV("faded", e.Faded) }>
				<span class="time">{ e.Time }</span>
				<span class="title">
					{ e.Title }
					if e.Hytta != "" {
						<span class="hytta">{ e.Hytta }</span>
					}
				</span>
			</div>
		}
	</div>
	<div class="days">
		for _, d := range c.Days {
			<div class="day">
				<div class="row1">
					@kidsDot(d.Kids)
					<span class="weekday">{ d.Label }</span>
					<span class="dinner">{ d.Dinner }</span>
					<span class="wx">{ d.Weather }</span>
				</div>
				if len(d.Events) > 0 {
					<div class="row2">
						for i, e := range d.Events {
							if i > 0 {
								<span class="sep">·</span>
							}
							<span class={ "item", templ.KV("faded", e.Faded) }>{ e.Text }</span>
						}
					</div>
				}
			</div>
		}
	</div>
	<div class="corner">
		if c.Bhg != "" {
			<span>{ c.Bhg }</span>
		}
		<span>bygd { st.Built }</span>
		<span>start { st.Started }</span>
		<span>lastet <span id="stamp-loaded"></span></span>
		<span>data <span id="stamp-data"></span></span>
	</div>
}

// kidsDot shows where the kids are: filled when here, a ring when away,
// and a half-filled dot on handover days (right half when they arrive,
// left half when they leave).
templ kidsDot(k calendar.KidsStatus) {
	switch k {
		case calendar.KidsFull:
			<span class="dot dot-full"></span>
		case calendar.KidsArriving:
			<span class="dot dot-arriving"></span>
		case calendar.KidsLeaving:
			<span class="dot dot-leaving"></span>
		default:
			<span class="dot dot-away"></span>
	}
}
