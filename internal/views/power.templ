package views

import "github.com/kvasbo/tellulf-v9/internal/view"

// Power is one bottom-row cell: the label, and once the feed has delivered,
// the power now with the day's consumption beside it, and a line with the
// price and the quota share.
templ Power(p view.Power) {
	<span class="label">{ p.Label }</span>
	if p.HasData {
		<div class="value">{ p.Power } <span class="today-kwh">{ p.Today } i dag</span></div>
		<div class="detail">{ p.Detail }</div>
	}
}
