// Package views holds the page's templ components. `go tool templ generate`
// turns each .templ file into Go code (the committed *_templ.go files).
package views

import "github.com/kvasbo/tellulf-v9/internal/view"

// Page is everything the full page renders. Each part is also sent on its
// own over SSE when it changes.
type Page struct {
	Version    string // the server's start time; a change reloads open screens
	Stamps     view.Stamps
	Weather    view.Weather
	Sun        view.Sun
	Calendar   view.Calendar
	PowerHome  view.Power
	PowerCabin view.Power
	Trains     view.Trains
}

// Layout is the full page: the clock, weather and bottom row on the left,
// the calendar on the right. The content of each element with data-sse is
// replaced by the fragment of that name from the event stream (see
// public/live.js). data-version on <body> is the server's start time;
// client.js reloads when the server reports a new one.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="nb">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tellulf</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400&display=swap"/>
			<link rel="stylesheet" href="/styles.css"/>
		</head>
		<body data-version={ p.Version }>
			<main>
				<section class="clock">
					<div id="now_time"></div>
					<div class="date"><span id="now_date"></span> <span id="now_week"></span></div>
				</section>
				<section class="weather" data-sse="weather">
					@Weather(p.Weather)
				</section>
				<section class="bottom">
					<div class="cell" data-sse="trains">
						@Entur(p.Trains)
					</div>
					<div class="cell" data-sse="power-home">
						@Power(p.PowerHome)
					</div>
					<div class="cell" data-sse="power-cabin">
						@Power(p.PowerCabin)
					</div>
				</section>
			</main>
			<aside class="calendar" data-sse="calendar">
				@Calendar(p.Calendar, p.Sun, p.Stamps)
			</aside>
			<script type="module" src="/client.js"></script>
		</body>
	</html>
}
