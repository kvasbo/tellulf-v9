{
	"name": "tellulf-v9",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.0.0",
		"npm": "0.0.0-use-bun-instead"
	},
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"start": "bun src/server.ts",
		"build": "biome check . && tsc --noEmit && bun build src/client.ts --outdir public --target browser",
		"lint": "biome check . --write",
		"format": "biome check --write .",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@googleapis/calendar": "^20.1.0",
		"eta": "^4.6.0",
		"google-auth-library": "^11.1.0",
		"htmx-ext-sse": "^2.2.4",
		"htmx.org": "^2.0.11",
		"idiomorph": "^0.8.0",
		"lunarphase-js": "^2.0.3",
		"luxon": "^3.7.2",
		"mqtt": "^5.16.0",
		"sunrise-sunset-js": "^3.3.1",
		"tibber-api": "^5.6.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/luxon": "^3.7.6",
		"bun-types": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
